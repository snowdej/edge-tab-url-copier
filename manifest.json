{
  "manifest_version": 3,
  "name": "Group & Selected Tab URL Copier",
  "version": "1.4.0",
  "description": "Copy selected/group tab URLs to the clipboard or open pasted URL lists.",
  "permissions": ["tabs", "tabGroups", "contextMenus", "clipboardWrite", "offscreen", "storage"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Copy or open tab URLs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "copy-urls": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Copy selected tabs or the active tab group"
    }
  }
}
